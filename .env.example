# Copy to .env for local development (`adk web` / `adk run` load it automatically).
# Never commit secrets here: production resolves the MCP URL from Secret Manager.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

MCP_URL_SECRET_ID=bacen-mcp-url
# BACEN_MCP_URL=http://localhost:8080/mcp   # local override only (ignored in production)
REPORTS_BUCKET=your-gcp-project-id-bacen-advisor-reports
MODEL_ARMOR_TEMPLATE=projects/your-gcp-project-id/locations/us-central1/templates/bacen-advisor-guardrails
VERTEX_SEARCH_DATASTORE=projects/your-gcp-project-id/locations/global/collections/default_collection/dataStores/bacen-methodology-kb

# Strategic Model Routing
MODEL_ROUTER=gemini-2.5-flash
MODEL_COLLECTOR=gemini-2.5-flash
MODEL_ANALYST=gemini-2.5-pro
MODEL_CRITIC=gemini-2.5-flash

# Observability & Privacy
PII_REDACTION_MODE=regex     # regex | dlp | off
ENABLE_CLOUD_TRACE=false
# ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false
LOG_LEVEL=INFO
